<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda_hand_gripper">

    <xacro:macro name="panda_hand_gripper" params="connected_to:='' ns:='' rpy:='0 0 0' xyz:='0 0 0' ">
        <xacro:unless value="${connected_to == ''}">
            <joint name="${ns}_hand_joint" type="fixed">
                <parent link="${connected_to}" />
                <child link="${ns}_hand" />
                <origin xyz="${xyz}" rpy="${rpy}" />
            </joint>
        </xacro:unless>

        <link name="${ns}_hand">
            <visual>
                <geometry>
                    <mesh filename="file://$(find franka)/meshes/visual/hand.dae" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="file://$(find franka)/meshes/collision/hand.stl" />
                </geometry>
            </collision>
            <inertial>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <mass value="0.68" />
                <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1" />
            </inertial>
        </link>
        
        <link name="${ns}_rightfinger">
            <visual>
                <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find franka)/meshes/visual/finger.dae" />
                </geometry>
            </visual>
            <collision>
                <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find franka)/meshes/collision/finger.stl" />
                </geometry>
            </collision>
            <inertial>
      		<origin rpy="0 0 3.141592653589793" xyz="-6.2561e-06 0.00227781 -0.0277116"/>
      		<mass value="0.2238453537819424"/>
      		<inertia ixx="6.74804167363695e-05" ixy="-4.1027443646025676e-09" ixz="1.8693673970152995e-08" iyy="6.627189221641395e-05" iyz="1.1967548474390802e-05" izz="1.550396267804825e-05"/>
    	    </inertial>
        </link>
        
        <link name="${ns}_leftfinger">
	    <visual>
	      <origin rpy="0 0 0" xyz="0 0 0"/>
	      <geometry>
		<mesh filename="file://$(find franka)/meshes/visual/finger.dae"/>
	      </geometry>
	    </visual>
	    <collision>
	      <origin rpy="0 0 0" xyz="0 0 0"/>
	      <geometry>
		<mesh filename="file://$(find franka)/meshes/collision/finger.stl"/>
	      </geometry>
	    </collision>
	    <inertial>
	      <origin rpy="0 0 0" xyz="-6.2561e-06 0.00227781 -0.0277116"/>
	      <mass value="0.2238453537819424"/>
	      <inertia ixx="6.74804167363695e-05" ixy="-4.1027443646025676e-09" ixz="1.8693673970152995e-08" iyy="6.627189221641395e-05" iyz="1.1967548474390802e-05" izz="1.550396267804825e-05"/>
	    </inertial>
	  </link>
	
        <joint name="${ns}_finger_joint1" type="prismatic">
            <parent link="${ns}_hand" />
            <child link="${ns}_leftfinger" />
            <origin xyz="0 0 0.0584" rpy="0 0 0" />
            <axis xyz="0 1 0"/>
	    <limit effort="20" lower="0" upper="0.04" velocity="0.2"/>
	    <dynamics damping="3.0" friction="0.4"/>
        </joint>
        
        <joint name="${ns}_finger_joint2" type="prismatic">
            <parent link="${ns}_hand" />
            <child link="${ns}_rightfinger" />
            <origin xyz="0 0 0.0584" rpy="0 0 0" />
            <axis xyz="0 -1 0"/>
	    <limit effort="20" lower="0" upper="0.04" velocity="0.2"/>
	    <dynamics damping="3.0" friction="0.4"/>
        </joint>
        
    </xacro:macro>
</robot>
